# Production runtime for `docker compose --env-file .env.production up -d`
# This file is intentionally placeholder-only and must never be committed with real values.

# Public ingress
PUBLIC_DOMAIN=hporterly.example.com
ACME_EMAIL=infra@example.com

# PostgreSQL
POSTGRES_DB=hporterly
POSTGRES_USER=hporterly_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
PGHOST=db
PGPORT=5432

# Backend
DATABASE_URL=postgresql://hporterly_user:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@db:5432/hporterly
HOST=0.0.0.0
PORT=8080
HL7_INTERNAL_PORT=8081
ENABLE_TLS=false
APP_ENV=production
ENVIRONMENT=production
LOG_FORMAT=json
RUST_LOG=info,hporterly=info,actix_web=info,diesel=warn

# Security
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Generate with: openssl rand -base64 32
MIRTH_WEBHOOK_SECRET=REPLACE_WITH_A_256_BIT_RANDOM_SECRET
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=REPLACE_WITH_A_BASE64_32_BYTE_KEY
MFA_ISSUER=HPorterly
MIRTH_ALLOWED_IP=127.0.0.1

# HTTP policy
CORS_ALLOWED_ORIGINS=https://hporterly.example.com
RATE_LIMIT_LOGIN_PER_IP=10
RATE_LIMIT_MFA_PER_ACCOUNT=5
RATE_LIMIT_API_PER_USER=300
AUDIT_RETENTION_DAYS=3650

# Internal CDA / HL7
CDA_MIRTH_ENDPOINT=http://localhost:6661/receive-cda

# Backups
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
# Optional: uncomment and point to an isolated bucket prefix
# S3_BACKUP_URI=s3://my-private-backups/hporterly
